{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latticeag.dev/schemas/vislineage/gap.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "subject",
    "related"
  ],
  "properties": {
    "code": {
      "enum": [
        "PARENT_MISSING",
        "PARENT_AMBIGUOUS",
        "OFFER_MISSING",
        "ACCEPT_MISSING",
        "DELEGATION_MISMATCH",
        "PARENT_HASH_MISMATCH",
        "DELEGATION_REUSED",
        "SOURCE_CONFLICT",
        "CYCLE",
        "ORIGIN_GAP",
        "ORIGIN_FORK"
      ]
    },
    "subject": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
