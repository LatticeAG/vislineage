{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latticeag.dev/schemas/vislineage/audit.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "body",
    "hash",
    "signature"
  ],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "workspace",
        "seq",
        "prev",
        "request",
        "key",
        "data"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "workspace": {
          "type": "string",
          "pattern": "^vlw_[-_0-9A-Za-z]{21}$"
        },
        "seq": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "prev": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "request": {
          "type": "string",
          "pattern": "^vlq_[-_0-9A-Za-z]{21}$"
        },
        "key": {
          "type": "string",
          "pattern": "^vlk_[-_0-9A-Za-z]{21}$"
        },
        "data": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "WorkspaceCreated",
                "SourceRegistered",
                "TraceCreated",
                "ImportStaged",
                "ImportCommitted",
                "ImportCancelled",
                "RetentionPruned",
                "KeyRotated"
              ]
            }
          },
          "description": "Closed tagged union on `kind` — see packages/core/src/schema.ts auditData() for each variant's exact member set"
        }
      }
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Ed25519 signature, 64 bytes, base64url"
    }
  }
}
