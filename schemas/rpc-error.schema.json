{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latticeag.dev/schemas/vislineage/rpc-error.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "retryable",
    "details"
  ],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "description": "Text: 1-256 Unicode scalars, <=1024 UTF-8 bytes, no C0/DEL controls"
    },
    "retryable": {
      "type": "boolean"
    },
    "details": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
