{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latticeag.dev/schemas/vislineage/origin.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "body",
    "hash",
    "signature"
  ],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "workspace",
        "source",
        "stream",
        "seq",
        "prev",
        "step",
        "key"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "workspace": {
          "type": "string",
          "pattern": "^vlw_[-_0-9A-Za-z]{21}$"
        },
        "source": {
          "type": "string",
          "pattern": "^vls_[-_0-9A-Za-z]{21}$"
        },
        "stream": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
          "description": "Text: 1-256 Unicode scalars, <=1024 UTF-8 bytes, no C0/DEL controls"
        },
        "seq": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "prev": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "step": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "key": {
          "type": "string",
          "pattern": "^vlk_[-_0-9A-Za-z]{21}$"
        }
      }
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Ed25519 signature, 64 bytes, base64url"
    }
  }
}
